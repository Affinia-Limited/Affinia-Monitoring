# Azure Monitoring Platform - example configuration.
# Copy to .env for local development. .env is git-ignored: never commit it.
# Placeholder values only. Real IDs belong in your local .env or in the deployment
# platform's configuration (Container Apps env vars / Key Vault references).
#
# FORMAT NOTES
# * List settings are comma-separated, e.g. CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# * Optional settings are commented out; uncomment and fill in when needed.
# * There is deliberately no AZURE_CLIENT_SECRET: the platform authenticates with Managed
#   Identity / Workload Identity (or `az login` in local development).

# ---------------------------------------------------------------- General
# development | test | staging | production
ENVIRONMENT=development
APP_NAME=Azure Monitoring Platform
LOG_LEVEL=INFO

# ---------------------------------------------------------------- Database
# Local docker-compose credentials only. In Azure use Entra authentication to PostgreSQL.
DATABASE_URL=postgresql+asyncpg://monitoring:monitoring@localhost:5432/monitoring
DATABASE_ECHO=false

# ---------------------------------------------------------------- Redis (cache + Celery broker)
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------- Authentication (Microsoft Entra ID)
# entra = validate Entra access tokens (required outside development)
# dev   = local development only; every request is a synthetic, clearly labelled dev user
AUTH_MODE=dev
# ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# v2 access tokens carry the API's client id in aud (api://<client-id> is also accepted)
# ENTRA_AUDIENCE=00000000-0000-0000-0000-000000000000
ENTRA_REQUIRED_SCOPE=access_as_user
# ENTRA_ALLOWED_TENANTS=00000000-0000-0000-0000-000000000000
ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# First Super Admin (bootstrap only; ignored once an active Super Admin exists).
# <object-id> for the home tenant, or <tenant-id>/<object-id>. See docs/user-access-management.md
# BOOTSTRAP_SUPER_ADMIN_OIDS=00000000-0000-0000-0000-000000000000
# Role of the synthetic user when AUTH_MODE=dev: super_admin | admin | operator | viewer
DEV_USER_ROLE=super_admin

# ---------------------------------------------------------------- Azure access (platform identity)
# azure = real Azure SDK calls; mock = deterministic demo data (development/test only)
AZURE_PROVIDER=mock
# Home tenant and client id of the user-assigned managed identity / workload identity
# AZURE_TENANT_ID=00000000-0000-0000-0000-000000000000
# AZURE_CLIENT_ID=00000000-0000-0000-0000-000000000000
# AZURE_ADDITIONALLY_ALLOWED_TENANTS=00000000-0000-0000-0000-000000000000
# KEY_VAULT_URL=https://<your-key-vault-name>.vault.azure.net/

# ---------------------------------------------------------------- Resource mapping (Azure tag keys)
PROJECT_TAG_KEYS=project,Project,application
ENVIRONMENT_TAG_KEYS=environment,Environment,env

# ---------------------------------------------------------------- Background jobs
# celery (Redis) | inline (in-process, development/test only)
TASK_BACKEND=inline
SYNC_INTERVAL_MINUTES=15
HEALTH_INTERVAL_MINUTES=5

# ---------------------------------------------------------------- Caching (seconds)
CACHE_TTL_METRICS=60
CACHE_TTL_RESOURCE_GRAPH=300
CACHE_TTL_HEALTH=120

# ---------------------------------------------------------------- HTTP
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
RATE_LIMIT_PER_MINUTE=300
RATE_LIMIT_KQL_PER_MINUTE=30
# Failed authentications / access denials tolerated per client IP per minute
RATE_LIMIT_AUTH_FAILURES_PER_MINUTE=30
LOG_QUERY_MAX_ROWS=5000
# Number of trusted reverse proxies in front of the API (Front Door + ingress = 2 in Azure)
TRUSTED_PROXY_COUNT=0

# ---------------------------------------------------------------- Frontend (Vite, public values only)
# These are compiled into the browser bundle. Never put secrets here.
VITE_API_BASE_URL=/api/v1
VITE_AUTH_MODE=dev
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
