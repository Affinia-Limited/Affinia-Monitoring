# Copy to .env.local for local development. Placeholder values only - never commit real values.
# "dev" skips Microsoft Entra ID (only works when the backend runs AUTH_MODE=dev); use "entra" otherwise.
VITE_AUTH_MODE=dev
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
VITE_ENTRA_REDIRECT_URI=http://localhost:5173
# API base path; same-origin by default
VITE_API_BASE_URL=/api/v1
# Backend used by the Vite dev proxy
VITE_BACKEND_URL=http://localhost:8000
